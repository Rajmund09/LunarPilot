# Virtual Environments
.venv/
env/
venv/
ENV/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Logs and TensorBoard
logs/
*.log

# Models & Weights (keep repo clean, checkpoint models are large)
models/
!models/.gitkeep
!models/registry.json

# Metrics & Figures generated at runtime
results/figures/*.png
results/metrics/*.csv
!results/figures/.gitkeep
!results/metrics/.gitkeep
!results/metrics/*.json
!results/training/**/meta.json
!results/training/**/metrics.jsonl
results/episodes/*.jsonl

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
