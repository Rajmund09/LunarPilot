  "max_grad_norm": 0.5,
  "evaluation_episodes": 10,
  "evaluation_interval": 10000,
  "checkpoint_interval": 50000,
  "model_save_dir": "models",
  "log_dir": "logs",
  "results_dir": "results"
}
